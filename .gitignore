.agents/
.clang-format
archive_pre_refactor/
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ==============================================================================
# Local Manuscript, Meeting & Scratch Artifacts
# ==============================================================================
# Keep research writing and transient console notes in the local workspace while
# excluding them from the public source/reproducibility repository.
/group_meeting_slides.md
/main.tex
/refs.bib
/AIOT2026.bib
/terminalText.zip
/terminal_result.txt
/testing.txt
/main.log
/dqn_ver1/
/terminalText/

# ==============================================================================
# Local Data, Workspace & Dependency Exclusions
# ==============================================================================
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# IDE settings
.vscode/

# Local third-party library dependencies (such as ONNX Runtime)
third_party/

# Keep historical training runs and locally exported models out of the public
# repository. The exact v7 publication checkpoint and deployment pair are the
# only model artifacts intentionally versioned.
/checkpoints/*
!/checkpoints/README.md
!/checkpoints/SHA256SUMS
!/checkpoints/v2x_online_brain_dqn_cmdp_v7_profiles.pth
!/checkpoints/v2x_agent_dqn_cmdp_v7_profiles_raw_q.onnx
!/checkpoints/v2x_agent_dqn_cmdp_v7_profiles_raw_q.onnx.data
/tools/rl_bridge/checkpoints/*

# ==============================================================================
# V2X QoS Experiment Output Exclusions & Whitelist
# ==============================================================================
# Ignore all generated outputs by default (raw simulation traces, bin packets, logs)
outputs/**/*

# Keep only the standalone amplification inputs/figures in Git. QoS single-run
# and multi-run results remain local by default; curated multi-run artifacts can
# be distributed separately as release assets without enlarging normal clones.
!outputs/plots/
!outputs/plots/amplification/
!outputs/plots/amplification/**/*

# Whitelist specific CSV files required for thesis plotting (rates 10.0, 5.0, 1.0)
!outputs/csv_raw/
!outputs/csv_raw/**/training_trace_10.0_mode*.csv
!outputs/csv_raw/**/training_trace_5.0_mode*.csv
!outputs/csv_raw/**/training_trace_1.0_mode*.csv
!outputs/csv_raw/**/fsm_trace_rate_10.0_mode*.csv
!outputs/csv_raw/**/fsm_trace_rate_5.0_mode*.csv
!outputs/csv_raw/**/fsm_trace_rate_1.0_mode*.csv
!outputs/csv_raw/**/amplification_profile.csv

# Minimal publication-facing multi-run results and the four measured figures
# referenced by the manuscript. All other generated combinations stay local.
!outputs/stats_multi_runs/
!outputs/stats_multi_runs/qos_multi_runs_aggregated.csv
!outputs/stats_multi_runs/timeline_representative_statistics.csv
!outputs/plots_multi_runs/
!outputs/plots_multi_runs/qos/
!outputs/plots_multi_runs/qos/master/
!outputs/plots_multi_runs/qos/master/jitter_mode0_10.0pct_onnx.pdf
!outputs/plots_multi_runs/qos/master/cdf_mode0_10.0pct_onnx.pdf
!outputs/plots_multi_runs/qos/timeline/
!outputs/plots_multi_runs/qos/timeline/pulse_recovery_timeline_onnx.pdf
!outputs/plots_multi_runs/qos/timeline/periodic_recovery_timeline_onnx.pdf

# ==============================================================================
# RWTH Aachen V2AIX Dataset Exclusions (Compliance with academic non-distribution license)
# ==============================================================================
*v2aix*
inputs/v2aix*
inputs/base_packets/v2aix*
inputs/*.tar.gz
json/

/tools/rl_bridge/src.zip
